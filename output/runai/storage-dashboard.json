{
   "description": "Node disk and Persistent Volume Claim health — utilization, capacity, and trends.",
   "editable": true,
   "graphTooltip": 1,
   "liveNow": true,
   "panels": [
      {
         "collapsed": false,
         "gridPos": {
            "h": 1,
            "w": 24,
            "x": 0,
            "y": 0
         },
         "id": 1,
         "title": "Disk & PVC Summary",
         "type": "row"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "description": "Average local disk utilization across selected nodes. Source: node-exporter (node_filesystem_*). High values risk DiskPressure and pod eviction.",
         "fieldConfig": {
            "defaults": {
               "color": {
                  "mode": "thresholds"
               },
               "max": 100,
               "min": 0,
               "thresholds": {
                  "steps": [
                     {
                        "color": "green",
                        "value": null
                     },
                     {
                        "color": "#EAB839",
                        "value": 75
                     },
                     {
                        "color": "red",
                        "value": 90
                     }
                  ]
               },
               "unit": "percent"
            }
         },
         "gridPos": {
            "h": 4,
            "w": 8,
            "x": 0,
            "y": 1
         },
         "id": 2,
         "options": {
            "colorMode": "value",
            "graphMode": "area",
            "reduceOptions": {
               "calcs": [
                  "lastNotNull"
               ]
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "avg(\n  100 - (\n    node_filesystem_avail_bytes{mountpoint=\"/\", fstype!=\"tmpfs\", instance=~\"$hostname\"}\n    / node_filesystem_size_bytes{mountpoint=\"/\", fstype!=\"tmpfs\", instance=~\"$hostname\"}\n    * 100\n  )\n)\n",
               "legendFormat": "Avg Disk %"
            }
         ],
         "title": "Avg Node Disk Used %",
         "type": "stat"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "description": "Number of Persistent Volume Claims in selected namespaces. Source: kubelet (kubelet_volume_stats_*).",
         "fieldConfig": {
            "defaults": {
               "color": {
                  "mode": "thresholds"
               },
               "thresholds": {
                  "steps": [
                     {
                        "color": "blue",
                        "value": null
                     }
                  ]
               },
               "unit": "short"
            }
         },
         "gridPos": {
            "h": 4,
            "w": 8,
            "x": 8,
            "y": 1
         },
         "id": 3,
         "options": {
            "colorMode": "value",
            "graphMode": "none",
            "reduceOptions": {
               "calcs": [
                  "lastNotNull"
               ]
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "count(kubelet_volume_stats_capacity_bytes{namespace=~\"$namespace\", node=~\"$hostname\"}) or vector(0)",
               "legendFormat": "PVCs"
            }
         ],
         "title": "Total PVCs",
         "type": "stat"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "description": "PVCs with storage utilization above 80%. These are at risk of running out of space — investigate or expand.",
         "fieldConfig": {
            "defaults": {
               "color": {
                  "mode": "thresholds"
               },
               "thresholds": {
                  "steps": [
                     {
                        "color": "green",
                        "value": null
                     },
                     {
                        "color": "#EAB839",
                        "value": 1
                     },
                     {
                        "color": "red",
                        "value": 3
                     }
                  ]
               },
               "unit": "short"
            }
         },
         "gridPos": {
            "h": 4,
            "w": 8,
            "x": 16,
            "y": 1
         },
         "id": 4,
         "options": {
            "colorMode": "value",
            "graphMode": "none",
            "reduceOptions": {
               "calcs": [
                  "lastNotNull"
               ]
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "count(\n  kubelet_volume_stats_used_bytes{namespace=~\"$namespace\", node=~\"$hostname\"}\n  / kubelet_volume_stats_capacity_bytes{namespace=~\"$namespace\", node=~\"$hostname\"}\n  > 0.80\n) or vector(0)\n",
               "legendFormat": "Critical"
            }
         ],
         "title": "PVCs > 80%",
         "type": "stat"
      },
      {
         "collapsed": false,
         "gridPos": {
            "h": 1,
            "w": 24,
            "x": 0,
            "y": 5
         },
         "id": 5,
         "title": "Node Disk Usage Over Time",
         "type": "row"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "description": "Local disk utilization over time for this node. Source: node-exporter. Mountpoint: /.",
         "fieldConfig": {
            "defaults": {
               "color": {
                  "mode": "thresholds"
               },
               "custom": {
                  "drawStyle": "line",
                  "fillOpacity": 10,
                  "lineInterpolation": "smooth",
                  "lineWidth": 2,
                  "showPoints": "never",
                  "spanNulls": false,
                  "stacking": {
                     "mode": "none"
                  },
                  "thresholdsStyle": {
                     "mode": "line"
                  }
               },
               "max": 100,
               "min": 0,
               "thresholds": {
                  "steps": [
                     {
                        "color": "green",
                        "value": null
                     },
                     {
                        "color": "#EAB839",
                        "value": 75
                     },
                     {
                        "color": "red",
                        "value": 90
                     }
                  ]
               },
               "unit": "percent"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 6
         },
         "id": 6,
         "options": {
            "legend": {
               "displayMode": "list",
               "placement": "bottom",
               "showLegend": true
            },
            "tooltip": {
               "mode": "multi",
               "sort": "desc"
            }
         },
         "pluginVersion": "v11.4.0",
         "repeat": "hostname",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "100 - (\n  node_filesystem_avail_bytes{mountpoint=\"/\", fstype!=\"tmpfs\", instance=~\"$hostname\"}\n  / node_filesystem_size_bytes{mountpoint=\"/\", fstype!=\"tmpfs\", instance=~\"$hostname\"}\n  * 100\n)\n",
               "legendFormat": "Disk Used %"
            }
         ],
         "title": "Node Disk Usage — $hostname",
         "type": "timeseries"
      },
      {
         "collapsed": false,
         "gridPos": {
            "h": 1,
            "w": 24,
            "x": 0,
            "y": 14
         },
         "id": 7,
         "title": "PVC Details",
         "type": "row"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "description": "Persistent Volume Claim utilization per namespace. Source: kubelet (kubelet_volume_stats_*). Sorted by Used % descending to surface full PVCs.",
         "fieldConfig": {
            "overrides": [
               {
                  "matcher": {
                     "id": "byName",
                     "options": "Used %"
                  },
                  "properties": [
                     {
                        "id": "custom.displayMode",
                        "value": "color-background"
                     },
                     {
                        "id": "custom.width",
                        "value": 120
                     },
                     {
                        "id": "decimals",
                        "value": 1
                     },
                     {
                        "id": "max",
                        "value": 100
                     },
                     {
                        "id": "min",
                        "value": 0
                     },
                     {
                        "id": "thresholds",
                        "value": {
                           "steps": [
                              {
                                 "color": "rgba(50, 172, 45, 0.2)",
                                 "value": null
                              },
                              {
                                 "color": "rgba(237, 129, 40, 0.2)",
                                 "value": 75
                              },
                              {
                                 "color": "rgba(245, 54, 54, 0.2)",
                                 "value": 90
                              }
                           ]
                        }
                     },
                     {
                        "id": "unit",
                        "value": "percent"
                     }
                  ]
               },
               {
                  "matcher": {
                     "id": "byName",
                     "options": "Used"
                  },
                  "properties": [
                     {
                        "id": "custom.width",
                        "value": 120
                     },
                     {
                        "id": "decimals",
                        "value": 1
                     },
                     {
                        "id": "unit",
                        "value": "decbytes"
                     }
                  ]
               },
               {
                  "matcher": {
                     "id": "byName",
                     "options": "Capacity"
                  },
                  "properties": [
                     {
                        "id": "custom.width",
                        "value": 120
                     },
                     {
                        "id": "decimals",
                        "value": 1
                     },
                     {
                        "id": "unit",
                        "value": "decbytes"
                     }
                  ]
               },
               {
                  "matcher": {
                     "id": "byName",
                     "options": "Namespace"
                  },
                  "properties": [
                     {
                        "id": "custom.width",
                        "value": 200
                     }
                  ]
               },
               {
                  "matcher": {
                     "id": "byName",
                     "options": "PVC"
                  },
                  "properties": [
                     {
                        "id": "custom.width",
                        "value": 300
                     }
                  ]
               }
            ]
         },
         "gridPos": {
            "h": 10,
            "w": 24,
            "x": 0,
            "y": 15
         },
         "id": 8,
         "options": {
            "showHeader": true,
            "sortBy": [
               {
                  "desc": true,
                  "displayName": "Used %"
               }
            ]
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "kubelet_volume_stats_used_bytes{namespace=~\"$namespace\", node=~\"$hostname\"}\n/ kubelet_volume_stats_capacity_bytes{namespace=~\"$namespace\", node=~\"$hostname\"}\n* 100\n",
               "format": "table",
               "instant": true,
               "refId": "A"
            },
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "kubelet_volume_stats_used_bytes{namespace=~\"$namespace\", node=~\"$hostname\"}",
               "format": "table",
               "instant": true,
               "refId": "B"
            },
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "kubelet_volume_stats_capacity_bytes{namespace=~\"$namespace\", node=~\"$hostname\"}",
               "format": "table",
               "instant": true,
               "refId": "C"
            }
         ],
         "title": "PVC Usage by Namespace",
         "transformations": [
            {
               "id": "merge",
               "options": { }
            },
            {
               "id": "organize",
               "options": {
                  "excludeByName": {
                     "Time": true,
                     "__name__": true,
                     "endpoint": true,
                     "instance": true,
                     "job": true,
                     "metrics_path": true,
                     "node": true,
                     "service": true
                  },
                  "indexByName": {
                     "Value #A": 2,
                     "Value #B": 3,
                     "Value #C": 4,
                     "namespace": 0,
                     "persistentvolumeclaim": 1
                  },
                  "renameByName": {
                     "Value #A": "Used %",
                     "Value #B": "Used",
                     "Value #C": "Capacity",
                     "namespace": "Namespace",
                     "persistentvolumeclaim": "PVC"
                  }
               }
            }
         ],
         "type": "table"
      },
      {
         "collapsed": false,
         "gridPos": {
            "h": 1,
            "w": 24,
            "x": 0,
            "y": 25
         },
         "id": 9,
         "title": "PVC Usage Over Time",
         "type": "row"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "description": "PVC utilization % over time per volume. Source: kubelet (kubelet_volume_stats_*).",
         "fieldConfig": {
            "defaults": {
               "color": {
                  "mode": "palette-classic"
               },
               "custom": {
                  "drawStyle": "line",
                  "fillOpacity": 10,
                  "lineInterpolation": "smooth",
                  "lineWidth": 2,
                  "showPoints": "never",
                  "spanNulls": false,
                  "stacking": {
                     "mode": "none"
                  },
                  "thresholdsStyle": {
                     "mode": "line"
                  }
               },
               "max": 100,
               "min": 0,
               "thresholds": {
                  "steps": [
                     {
                        "color": "green",
                        "value": null
                     },
                     {
                        "color": "#EAB839",
                        "value": 75
                     },
                     {
                        "color": "red",
                        "value": 90
                     }
                  ]
               },
               "unit": "percent"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 24,
            "x": 0,
            "y": 26
         },
         "id": 10,
         "options": {
            "legend": {
               "calcs": [
                  "mean",
                  "max",
                  "last"
               ],
               "displayMode": "table",
               "placement": "right",
               "showLegend": true,
               "sortBy": "Last",
               "sortDesc": true
            },
            "tooltip": {
               "mode": "multi",
               "sort": "desc"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "kubelet_volume_stats_used_bytes{namespace=~\"$namespace\", node=~\"$hostname\"}\n/ kubelet_volume_stats_capacity_bytes{namespace=~\"$namespace\", node=~\"$hostname\"}\n* 100\n",
               "legendFormat": "{{namespace}}/{{persistentvolumeclaim}}"
            }
         ],
         "title": "PVC Usage Over Time",
         "type": "timeseries"
      }
   ],
   "refresh": "30s",
   "schemaVersion": 39,
   "tags": [
      "storage",
      "disk",
      "pvc",
      "node-exporter",
      "kubelet",
      "runai"
   ],
   "templating": {
      "list": [
         {
            "name": "datasource",
            "query": "prometheus",
            "type": "datasource"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "includeAll": false,
            "multi": true,
            "name": "hostname",
            "query": "label_values(DCGM_FI_DEV_FB_USED, Hostname)",
            "refresh": 2,
            "sort": 1,
            "type": "query"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "includeAll": true,
            "multi": true,
            "name": "namespace",
            "query": "label_values(DCGM_FI_DEV_FB_USED{exported_namespace!=\"\"}, exported_namespace)",
            "refresh": 2,
            "sort": 1,
            "type": "query"
         }
      ]
   },
   "time": {
      "from": "now-6h",
      "to": "now"
   },
   "timepicker": {
      "refresh_intervals": [
         "10s",
         "30s",
         "1m",
         "5m",
         "15m",
         "30m",
         "1h"
      ]
   },
   "timezone": "",
   "title": "Storage (Node Disk + PVC)",
   "uid": "storage-dashboard"
}
