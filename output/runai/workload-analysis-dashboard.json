{
   "description": "Per-deployment and per-workload GPU, CPU, and RAM breakdown. Mirrors Run:AI per-project/workload view.",
   "editable": true,
   "graphTooltip": 1,
   "liveNow": true,
   "panels": [
      {
         "collapsed": false,
         "gridPos": {
            "h": 1,
            "w": 24,
            "x": 0,
            "y": 0
         },
         "id": 1,
         "title": "CPU & RAM by Deployment",
         "type": "row"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "description": "Node CPU (millicores) and RAM (MiB) usage per Kubernetes deployment. Source: kube-state-metrics + cAdvisor.",
         "fieldConfig": {
            "overrides": [
               {
                  "matcher": {
                     "id": "byName",
                     "options": "CPU Used (m)"
                  },
                  "properties": [
                     {
                        "id": "custom.width",
                        "value": 130
                     },
                     {
                        "id": "decimals",
                        "value": 0
                     },
                     {
                        "id": "unit",
                        "value": "short"
                     }
                  ]
               },
               {
                  "matcher": {
                     "id": "byName",
                     "options": "CPU Requested (m)"
                  },
                  "properties": [
                     {
                        "id": "custom.width",
                        "value": 160
                     },
                     {
                        "id": "decimals",
                        "value": 0
                     },
                     {
                        "id": "unit",
                        "value": "short"
                     }
                  ]
               },
               {
                  "matcher": {
                     "id": "byName",
                     "options": "RAM Used (MiB)"
                  },
                  "properties": [
                     {
                        "id": "custom.width",
                        "value": 140
                     },
                     {
                        "id": "decimals",
                        "value": 0
                     },
                     {
                        "id": "unit",
                        "value": "decmbytes"
                     }
                  ]
               },
               {
                  "matcher": {
                     "id": "byName",
                     "options": "RAM Requested (MiB)"
                  },
                  "properties": [
                     {
                        "id": "custom.width",
                        "value": 165
                     },
                     {
                        "id": "decimals",
                        "value": 0
                     },
                     {
                        "id": "unit",
                        "value": "decmbytes"
                     }
                  ]
               },
               {
                  "matcher": {
                     "id": "byName",
                     "options": "Deployment"
                  },
                  "properties": [
                     {
                        "id": "custom.width",
                        "value": 260
                     }
                  ]
               },
               {
                  "matcher": {
                     "id": "byName",
                     "options": "Namespace"
                  },
                  "properties": [
                     {
                        "id": "custom.width",
                        "value": 180
                     }
                  ]
               }
            ]
         },
         "gridPos": {
            "h": 10,
            "w": 24,
            "x": 0,
            "y": 1
         },
         "id": 2,
         "options": {
            "showHeader": true,
            "sortBy": [
               {
                  "desc": true,
                  "displayName": "RAM Used (MiB)"
               }
            ]
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "sum by (deployment, namespace) (\n  rate(container_cpu_usage_seconds_total{container!=\"\", container!=\"POD\"}[5m]) * 1000\n* on(pod, namespace) group_left(deployment)\nlabel_replace(\n  kube_pod_owner{owner_kind=\"ReplicaSet\"},\n  \"deployment\", \"$1\", \"owner_name\", \"(.+)-[^-]+\"\n)\n)",
               "format": "table",
               "instant": true,
               "refId": "A"
            },
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "sum by (deployment, namespace) (\n  kube_pod_container_resource_requests{resource=\"cpu\", container!=\"\"}\n  * 1000\n* on(pod, namespace) group_left(deployment)\nlabel_replace(\n  kube_pod_owner{owner_kind=\"ReplicaSet\"},\n  \"deployment\", \"$1\", \"owner_name\", \"(.+)-[^-]+\"\n)\n)",
               "format": "table",
               "instant": true,
               "refId": "B"
            },
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "sum by (deployment, namespace) (\n  container_memory_working_set_bytes{container!=\"\", container!=\"POD\"}\n  / (1024 * 1024)\n* on(pod, namespace) group_left(deployment)\nlabel_replace(\n  kube_pod_owner{owner_kind=\"ReplicaSet\"},\n  \"deployment\", \"$1\", \"owner_name\", \"(.+)-[^-]+\"\n)\n)",
               "format": "table",
               "instant": true,
               "refId": "C"
            },
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "sum by (deployment, namespace) (\n  kube_pod_container_resource_requests{resource=\"memory\", container!=\"\"}\n  / (1024 * 1024)\n* on(pod, namespace) group_left(deployment)\nlabel_replace(\n  kube_pod_owner{owner_kind=\"ReplicaSet\"},\n  \"deployment\", \"$1\", \"owner_name\", \"(.+)-[^-]+\"\n)\n)",
               "format": "table",
               "instant": true,
               "refId": "D"
            }
         ],
         "title": "CPU & RAM by Deployment",
         "transformations": [
            {
               "id": "merge",
               "options": { }
            },
            {
               "id": "organize",
               "options": {
                  "excludeByName": {
                     "Time": true
                  },
                  "indexByName": {
                     "Value #A": 3,
                     "Value #B": 4,
                     "Value #C": 5,
                     "Value #D": 6,
                     "deployment": 1,
                     "namespace": 2
                  },
                  "renameByName": {
                     "Value #A": "CPU Used (m)",
                     "Value #B": "CPU Requested (m)",
                     "Value #C": "RAM Used (MiB)",
                     "Value #D": "RAM Requested (MiB)",
                     "deployment": "Deployment",
                     "namespace": "Namespace"
                  }
               }
            }
         ],
         "type": "table"
      },
      {
         "collapsed": false,
         "gridPos": {
            "h": 1,
            "w": 24,
            "x": 0,
            "y": 11
         },
         "id": 3,
         "title": "Workload GPU Usage",
         "type": "row"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "description": "Per-workload GPU usage. VRAM shown as Used/Total (MiB).",
         "fieldConfig": {
            "overrides": [
               {
                  "matcher": {
                     "id": "byName",
                     "options": "Compute %"
                  },
                  "properties": [
                     {
                        "id": "custom.displayMode",
                        "value": "gradient-gauge"
                     },
                     {
                        "id": "custom.width",
                        "value": 150
                     },
                     {
                        "id": "max",
                        "value": 100
                     },
                     {
                        "id": "min",
                        "value": 0
                     },
                     {
                        "id": "thresholds",
                        "value": {
                           "steps": [
                              {
                                 "color": "green",
                                 "value": null
                              },
                              {
                                 "color": "#EAB839",
                                 "value": 60
                              },
                              {
                                 "color": "red",
                                 "value": 85
                              }
                           ]
                        }
                     }
                  ]
               },
               {
                  "matcher": {
                     "id": "byName",
                     "options": "VRAM Used (MiB)"
                  },
                  "properties": [
                     {
                        "id": "custom.width",
                        "value": 140
                     },
                     {
                        "id": "decimals",
                        "value": 0
                     },
                     {
                        "id": "unit",
                        "value": "decmbytes"
                     }
                  ]
               },
               {
                  "matcher": {
                     "id": "byName",
                     "options": "VRAM Total (MiB)"
                  },
                  "properties": [
                     {
                        "id": "custom.width",
                        "value": 140
                     },
                     {
                        "id": "decimals",
                        "value": 0
                     },
                     {
                        "id": "unit",
                        "value": "decmbytes"
                     }
                  ]
               },
               {
                  "matcher": {
                     "id": "byName",
                     "options": "Workload"
                  },
                  "properties": [
                     {
                        "id": "custom.width",
                        "value": 260
                     }
                  ]
               },
               {
                  "matcher": {
                     "id": "byName",
                     "options": "Namespace"
                  },
                  "properties": [
                     {
                        "id": "custom.width",
                        "value": 180
                     }
                  ]
               },
               {
                  "matcher": {
                     "id": "byName",
                     "options": "Node"
                  },
                  "properties": [
                     {
                        "id": "custom.width",
                        "value": 160
                     }
                  ]
               },
               {
                  "matcher": {
                     "id": "byName",
                     "options": "GPU Model"
                  },
                  "properties": [
                     {
                        "id": "custom.width",
                        "value": 100
                     }
                  ]
               }
            ]
         },
         "gridPos": {
            "h": 10,
            "w": 24,
            "x": 0,
            "y": 12
         },
         "id": 4,
         "options": {
            "showHeader": true,
            "sortBy": [
               {
                  "desc": true,
                  "displayName": "Compute %"
               }
            ]
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "avg by (exported_pod, exported_namespace, gpu, GPU_I_ID, Hostname, modelName) (\n  DCGM_FI_PROF_GR_ENGINE_ACTIVE{exported_pod!=\"\", Hostname=~\"$hostname\"} * 100\n)\n",
               "format": "table",
               "instant": true,
               "refId": "A"
            },
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "avg by (exported_pod, exported_namespace, gpu, GPU_I_ID, Hostname, modelName) (\n  DCGM_FI_DEV_FB_USED{exported_pod!=\"\", Hostname=~\"$hostname\"}\n)\n",
               "format": "table",
               "instant": true,
               "refId": "B"
            },
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "avg by (exported_pod, exported_namespace, gpu, GPU_I_ID, Hostname, modelName) (\n  DCGM_FI_DEV_FB_USED{exported_pod!=\"\", Hostname=~\"$hostname\"} + DCGM_FI_DEV_FB_FREE{exported_pod!=\"\", Hostname=~\"$hostname\"}\n)\n",
               "format": "table",
               "instant": true,
               "refId": "C"
            }
         ],
         "title": "Workload GPU Usage",
         "transformations": [
            {
               "id": "merge",
               "options": { }
            },
            {
               "id": "organize",
               "options": {
                  "excludeByName": {
                     "Time": true,
                     "gpu": true
                  },
                  "indexByName": {
                     "GPU_I_ID": 5,
                     "Hostname": 3,
                     "Value #A": 6,
                     "Value #B": 7,
                     "Value #C": 8,
                     "exported_namespace": 2,
                     "exported_pod": 1,
                     "modelName": 4
                  },
                  "renameByName": {
                     "GPU_I_ID": "MIG ID",
                     "Hostname": "Node",
                     "Value #A": "Compute %",
                     "Value #B": "VRAM Used (MiB)",
                     "Value #C": "VRAM Total (MiB)",
                     "exported_namespace": "Namespace",
                     "exported_pod": "Workload",
                     "modelName": "GPU Model"
                  }
               }
            }
         ],
         "type": "table"
      },
      {
         "collapsed": false,
         "gridPos": {
            "h": 1,
            "w": 24,
            "x": 0,
            "y": 22
         },
         "id": 5,
         "title": "Workload Compute % Over Time",
         "type": "row"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "description": "GPU compute activity per workload on this node (GR engine active %)",
         "fieldConfig": {
            "defaults": {
               "color": {
                  "mode": "palette-classic"
               },
               "custom": {
                  "drawStyle": "line",
                  "fillOpacity": 10,
                  "lineInterpolation": "smooth",
                  "lineWidth": 2,
                  "showPoints": "never",
                  "spanNulls": false,
                  "stacking": {
                     "mode": "none"
                  },
                  "thresholdsStyle": {
                     "mode": "line"
                  }
               },
               "max": 100,
               "min": 0,
               "thresholds": {
                  "steps": [
                     {
                        "color": "green",
                        "value": null
                     },
                     {
                        "color": "#EAB839",
                        "value": 60
                     },
                     {
                        "color": "red",
                        "value": 85
                     }
                  ]
               },
               "unit": "percent"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 24,
            "x": 0,
            "y": 23
         },
         "id": 6,
         "options": {
            "legend": {
               "calcs": [
                  "mean",
                  "max",
                  "last"
               ],
               "displayMode": "table",
               "placement": "right",
               "showLegend": true,
               "sortBy": "Last",
               "sortDesc": true
            },
            "tooltip": {
               "mode": "multi",
               "sort": "desc"
            }
         },
         "pluginVersion": "v11.4.0",
         "repeat": "hostname",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "avg by (exported_pod, exported_namespace, Hostname, modelName, GPU_I_PROFILE) (\n  DCGM_FI_PROF_GR_ENGINE_ACTIVE{exported_pod!=\"\", Hostname=~\"$hostname\"} * 100\n)\n",
               "legendFormat": "{{exported_namespace}}/{{exported_pod}} ({{GPU_I_PROFILE}})"
            }
         ],
         "title": "Workload Compute % — $hostname",
         "type": "timeseries"
      }
   ],
   "refresh": "30s",
   "schemaVersion": 39,
   "tags": [
      "gpu",
      "workload",
      "deployment",
      "dcgm",
      "runai"
   ],
   "templating": {
      "list": [
         {
            "name": "datasource",
            "query": "prometheus",
            "type": "datasource"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "includeAll": false,
            "multi": true,
            "name": "hostname",
            "query": "label_values(DCGM_FI_DEV_FB_USED, Hostname)",
            "refresh": 2,
            "sort": 1,
            "type": "query"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "includeAll": true,
            "multi": true,
            "name": "namespace",
            "query": "label_values(DCGM_FI_DEV_FB_USED{exported_namespace!=\"\"}, exported_namespace)",
            "refresh": 2,
            "sort": 1,
            "type": "query"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "includeAll": true,
            "multi": true,
            "name": "workload",
            "query": "label_values(DCGM_FI_DEV_FB_USED{exported_pod!=\"\"}, exported_pod)",
            "refresh": 2,
            "sort": 1,
            "type": "query"
         }
      ]
   },
   "time": {
      "from": "now-6h",
      "to": "now"
   },
   "timepicker": {
      "refresh_intervals": [
         "10s",
         "30s",
         "1m",
         "5m",
         "15m",
         "30m",
         "1h"
      ]
   },
   "timezone": "",
   "title": "Workload Analysis",
   "uid": "workload-analysis"
}
