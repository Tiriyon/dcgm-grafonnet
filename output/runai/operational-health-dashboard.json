{
   "description": "GPU operational health trends — power, temperature, clock, compute, tensor utilization, and disk usage. Mirrors Run:AI Analytics.",
   "editable": true,
   "graphTooltip": 1,
   "liveNow": true,
   "panels": [
      {
         "collapsed": false,
         "gridPos": {
            "h": 1,
            "w": 24,
            "x": 0,
            "y": 0
         },
         "id": 1,
         "title": "Thermal & Power",
         "type": "row"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "description": "Power usage over time per device (filtered by selected nodes)",
         "fieldConfig": {
            "defaults": {
               "color": {
                  "mode": "palette-classic"
               },
               "custom": {
                  "drawStyle": "line",
                  "fillOpacity": 10,
                  "lineInterpolation": "smooth",
                  "lineWidth": 2,
                  "showPoints": "never",
                  "spanNulls": false,
                  "stacking": {
                     "mode": "none"
                  },
                  "thresholdsStyle": {
                     "mode": "off"
                  }
               },
               "thresholds": {
                  "steps": [
                     {
                        "color": "green",
                        "value": null
                     }
                  ]
               },
               "unit": "watt"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 1
         },
         "id": 2,
         "options": {
            "legend": {
               "calcs": [
                  "mean",
                  "max"
               ],
               "displayMode": "table",
               "placement": "right",
               "showLegend": true
            },
            "tooltip": {
               "mode": "multi",
               "sort": "desc"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "avg by (gpu, GPU_I_ID, Hostname, UUID) (\n  DCGM_FI_DEV_POWER_USAGE{Hostname=~\"$hostname\"}\n)\n",
               "legendFormat": "{{Hostname}}-GPU{{gpu}}-MIG{{GPU_I_ID}}"
            }
         ],
         "title": "Power Usage by Device",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "description": "Temperature over time per device (filtered by selected nodes)",
         "fieldConfig": {
            "defaults": {
               "color": {
                  "mode": "palette-classic"
               },
               "custom": {
                  "drawStyle": "line",
                  "fillOpacity": 10,
                  "lineInterpolation": "smooth",
                  "lineWidth": 2,
                  "showPoints": "never",
                  "spanNulls": false,
                  "stacking": {
                     "mode": "none"
                  },
                  "thresholdsStyle": {
                     "mode": "line"
                  }
               },
               "thresholds": {
                  "steps": [
                     {
                        "color": "green",
                        "value": null
                     },
                     {
                        "color": "#EAB839",
                        "value": 70
                     },
                     {
                        "color": "red",
                        "value": 80
                     }
                  ]
               },
               "unit": "celsius"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 1
         },
         "id": 3,
         "options": {
            "legend": {
               "calcs": [
                  "mean",
                  "max"
               ],
               "displayMode": "table",
               "placement": "right",
               "showLegend": true
            },
            "tooltip": {
               "mode": "multi",
               "sort": "desc"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "avg by (gpu, GPU_I_ID, Hostname, UUID) (\n  DCGM_FI_DEV_GPU_TEMP{Hostname=~\"$hostname\"}\n)\n",
               "legendFormat": "{{Hostname}}-GPU{{gpu}}-MIG{{GPU_I_ID}}"
            }
         ],
         "title": "Temperature by Device",
         "type": "timeseries"
      },
      {
         "collapsed": false,
         "gridPos": {
            "h": 1,
            "w": 24,
            "x": 0,
            "y": 9
         },
         "id": 4,
         "title": "Compute & Clock",
         "type": "row"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "description": "Top 10 GPU/MIG devices by GR engine active % (pure compute, no composite formula)",
         "fieldConfig": {
            "defaults": {
               "color": {
                  "mode": "palette-classic"
               },
               "custom": {
                  "drawStyle": "line",
                  "fillOpacity": 10,
                  "lineInterpolation": "smooth",
                  "lineWidth": 2,
                  "showPoints": "never",
                  "spanNulls": false,
                  "stacking": {
                     "mode": "none"
                  },
                  "thresholdsStyle": {
                     "mode": "line"
                  }
               },
               "max": 100,
               "min": 0,
               "thresholds": {
                  "steps": [
                     {
                        "color": "green",
                        "value": null
                     },
                     {
                        "color": "#EAB839",
                        "value": 60
                     },
                     {
                        "color": "red",
                        "value": 85
                     }
                  ]
               },
               "unit": "percent"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 24,
            "x": 0,
            "y": 10
         },
         "id": 5,
         "options": {
            "legend": {
               "calcs": [
                  "mean",
                  "max",
                  "last"
               ],
               "displayMode": "table",
               "placement": "right",
               "showLegend": true,
               "sortBy": "Last",
               "sortDesc": true
            },
            "tooltip": {
               "mode": "multi",
               "sort": "desc"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "topk(10,\n  avg by (gpu, GPU_I_ID, GPU_I_PROFILE, Hostname, modelName, UUID) (\n    DCGM_FI_PROF_GR_ENGINE_ACTIVE{Hostname=~\"$hostname\"} * 100\n  )\n)\n",
               "legendFormat": "{{Hostname}}-GPU{{gpu}}-{{GPU_I_PROFILE}}"
            }
         ],
         "title": "Top 10 Devices by Compute %",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "description": "SM Clock frequency by GPU model",
         "fieldConfig": {
            "defaults": {
               "color": {
                  "mode": "palette-classic"
               },
               "custom": {
                  "drawStyle": "line",
                  "fillOpacity": 10,
                  "lineInterpolation": "smooth",
                  "lineWidth": 2,
                  "showPoints": "never",
                  "spanNulls": false,
                  "stacking": {
                     "mode": "none"
                  },
                  "thresholdsStyle": {
                     "mode": "off"
                  }
               },
               "thresholds": {
                  "steps": [
                     {
                        "color": "green",
                        "value": null
                     }
                  ]
               },
               "unit": "none"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 18
         },
         "id": 6,
         "options": {
            "legend": {
               "calcs": [
                  "mean",
                  "max"
               ],
               "displayMode": "table",
               "placement": "right",
               "showLegend": true
            },
            "tooltip": {
               "mode": "multi",
               "sort": "desc"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "avg by (modelName) (DCGM_FI_DEV_SM_CLOCK{exported_namespace!=\"\",Hostname=~\"$hostname\"})",
               "legendFormat": "{{modelName}}"
            }
         ],
         "title": "SM Clock by GPU Model",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "description": "Tensor core utilization per workload",
         "fieldConfig": {
            "defaults": {
               "color": {
                  "mode": "palette-classic"
               },
               "custom": {
                  "drawStyle": "line",
                  "fillOpacity": 10,
                  "lineInterpolation": "smooth",
                  "lineWidth": 2,
                  "showPoints": "never",
                  "spanNulls": false,
                  "stacking": {
                     "mode": "none"
                  },
                  "thresholdsStyle": {
                     "mode": "off"
                  }
               },
               "max": 100,
               "min": 0,
               "thresholds": {
                  "steps": [
                     {
                        "color": "green",
                        "value": null
                     }
                  ]
               },
               "unit": "percent"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 18
         },
         "id": 7,
         "options": {
            "legend": {
               "calcs": [
                  "mean",
                  "max"
               ],
               "displayMode": "table",
               "placement": "right",
               "showLegend": true
            },
            "tooltip": {
               "mode": "multi",
               "sort": "desc"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "avg by (exported_pod) (DCGM_FI_PROF_PIPE_TENSOR_ACTIVE{exported_pod!=\"\", Hostname=~\"$hostname\"} * 100)",
               "legendFormat": "{{exported_pod}}"
            }
         ],
         "title": "Tensor Utilization by Workload",
         "type": "timeseries"
      },
      {
         "collapsed": false,
         "gridPos": {
            "h": 1,
            "w": 24,
            "x": 0,
            "y": 26
         },
         "id": 8,
         "title": "Node Disk",
         "type": "row"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "description": "Local disk utilization over time for this node. Source: node-exporter. Mountpoint: /.",
         "fieldConfig": {
            "defaults": {
               "color": {
                  "mode": "thresholds"
               },
               "custom": {
                  "drawStyle": "line",
                  "fillOpacity": 10,
                  "lineInterpolation": "smooth",
                  "lineWidth": 2,
                  "showPoints": "never",
                  "spanNulls": false,
                  "stacking": {
                     "mode": "none"
                  },
                  "thresholdsStyle": {
                     "mode": "line"
                  }
               },
               "max": 100,
               "min": 0,
               "thresholds": {
                  "steps": [
                     {
                        "color": "green",
                        "value": null
                     },
                     {
                        "color": "#EAB839",
                        "value": 75
                     },
                     {
                        "color": "red",
                        "value": 90
                     }
                  ]
               },
               "unit": "percent"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 27
         },
         "id": 9,
         "options": {
            "legend": {
               "displayMode": "list",
               "placement": "bottom",
               "showLegend": true
            },
            "tooltip": {
               "mode": "multi",
               "sort": "desc"
            }
         },
         "pluginVersion": "v11.4.0",
         "repeat": "hostname",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "100 - (\n  node_filesystem_avail_bytes{mountpoint=\"/\", fstype!=\"tmpfs\", instance=~\"$hostname\"}\n  / node_filesystem_size_bytes{mountpoint=\"/\", fstype!=\"tmpfs\", instance=~\"$hostname\"}\n  * 100\n)\n",
               "legendFormat": "Disk Used %"
            }
         ],
         "title": "Node Disk Usage — $hostname",
         "type": "timeseries"
      }
   ],
   "refresh": "30s",
   "schemaVersion": 39,
   "tags": [
      "gpu",
      "operational-health",
      "analytics",
      "dcgm",
      "runai"
   ],
   "templating": {
      "list": [
         {
            "name": "datasource",
            "query": "prometheus",
            "type": "datasource"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "includeAll": false,
            "multi": true,
            "name": "hostname",
            "query": "label_values(DCGM_FI_DEV_FB_USED, Hostname)",
            "refresh": 2,
            "sort": 1,
            "type": "query"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "includeAll": true,
            "multi": true,
            "name": "gpu_model",
            "query": "label_values(DCGM_FI_DEV_FB_USED, modelName)",
            "refresh": 2,
            "sort": 1,
            "type": "query"
         }
      ]
   },
   "time": {
      "from": "now-6h",
      "to": "now"
   },
   "timepicker": {
      "refresh_intervals": [
         "10s",
         "30s",
         "1m",
         "5m",
         "15m",
         "30m",
         "1h"
      ]
   },
   "timezone": "",
   "title": "Operational Health / Analytics",
   "uid": "operational-health"
}
